{
  "name": "@qrsln/lootstrap",
  "version": "26.3.19",
  "scripts": {
    "/************        Pre~        ************/": " --- Start --- ",
    "Clean-dist": "rimraf dist/css dist/css",
    "Change-version": "node build/VersionUpdater.mjs",
    "Change-header": "node build/CssBanner.mjs",
    "css-pre": "npm-run-all Clean-dist Change-version Change-header",
    "/************        ~CSS        ************/": " --- End --- ",
    "css": "npm-run-all css-pre css-compile css-clean css-prefix css-minify",
    "css-compile": "sass --style expanded --source-map --embed-sources --no-error-css scss/:dist/css/",
    "css-clean": "npm-run-all --aggregate-output --parallel css-clean-*",
    "css-clean-main": "cleancss -O1 --format beautify --output dist/css/lootstrap.css dist/css/lootstrap.css",
    "css-clean-basic": "cleancss -O1 --format beautify --output dist/css/lootstrap-basic.css dist/css/lootstrap-basic.css",
    "css-prefix": "npm-run-all --aggregate-output --parallel css-prefix-*",
    "css-prefix-main": "postcss --config build/Config/postcss.config.mjs --replace \"dist/css/*.css\" \"!dist/css/*.rtl*.css\" \"!dist/css/*.min.css\"",
    "css-minify": "npm-run-all --aggregate-output --parallel css-minify-*",
    "css-minify-main": "cleancss -O1 --format breakWith=lf --with-rebase --source-map --source-map-inline-sources --output dist/css/ --batch --batch-suffix \".min\" \"dist/css/*.css\" \"!dist/css/*.min.css\" \"!dist/css/*rtl*.css\"",
    "/************        JS        ************/": " --- End --- ",
    "js": "npm-run-all js-compile js-minify",
    "js-compile": "npm-run-all --aggregate-output --parallel js-compile-*",
    "js-compile-standalone": "rollup --environment BUNDLE:false --config build/Config/rollup.config.mjs --sourcemap",
    "js-compile-standalone-esm": "rollup --environment ESM:true,BUNDLE:false --config build/Config/rollup.config.mjs --sourcemap",
    "js-compile-bundle": "rollup --environment BUNDLE:true --config build/Config/rollup.config.mjs --sourcemap",
    "js-minify": "npm-run-all --aggregate-output --parallel js-minify-*",
    "js-minify-standalone": "terser --compress passes=2 --mangle --comments \"/^!/\" --source-map \"content=dist/js/lootstrap.js.map,includeSources,url=lootstrap.min.js.map\" --output dist/js/lootstrap.min.js dist/js/lootstrap.js",
    "js-minify-standalone-esm": "terser --compress passes=2 --mangle --comments \"/^!/\" --source-map \"content=dist/js/lootstrap.esm.js.map,includeSources,url=lootstrap.esm.min.js.map\" --output dist/js/lootstrap.esm.min.js dist/js/lootstrap.esm.js",
    "js-minify-bundle": "terser --compress passes=2 --mangle --comments \"/^!/\" --source-map \"content=dist/js/lootstrap.bundle.js.map,includeSources,url=lootstrap.bundle.min.js.map\" --output dist/js/lootstrap.bundle.min.js dist/js/lootstrap.bundle.js",
    "/************        Watch        ************/": " --- End --- ",
    "sass:Watch": "sass  --watch scss/:dist/css/",
    "/************        Test        ************/": " --- End --- ",
    "testTODO": "",
    "sass:Watch-Color": "sass  --watch Docs/Colors/:Tests/Colors/",
    "/************        / PUBLISH /        ************/": " --- End --- ",
    "dist": "npm-run-all --aggregate-output --parallel css js",
    "p:live": "npm run dist && npm publish --access public",
    "p:beta": "npm run dist && npm publish --tag beta --access public"
  },
  "description": "Lootstrap is a scss library and is still in beta! There is much to improve!",
  "main": "dist/js/lootstrap.js",
  "module": "dist/js/lootstrap.esm.js",
  "style": "dist/css/lootstrap.css",
  "sass": "scss/lootstrap.scss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krsln/Lootstrap.git"
  },
  "keywords": [
    "Lootstrap",
    "css",
    "sass",
    "scss",
    "responsive",
    "front-end",
    "framework",
    "web"
  ],
  "author": "Qrsln",
  "license": "MIT",
  "files": [
    "dist/css",
    "scss/**/*.scss"
  ],
  "bugs": {
    "url": "https://github.com/krsln/Lootstrap/issues"
  },
  "homepage": "https://krsln.github.io/Lootstrap/Overview",
  "devDependencies": {
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "autoprefixer": "^10.4.27",
    "clean-css-cli": "^5.6.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.0",
    "terser": "^5.46.1",
    "sass": "^1.98.0"
  }
}
